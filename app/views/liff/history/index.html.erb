<%= render "shared/history_dashboard" %>
<%= render "shared/history_chart_scripts" %>

<script>
const LIFF_ID_HISTORY = "<%= ENV['LIFF_ID_HISTORY'] %>";

liff.init({ liffId: LIFF_ID_HISTORY })
  .then(() => {
    if (!liff.isLoggedIn()) {
      liff.login();
      return;
    }

    // IDトークンを取得してRailsに送りセッション保存
    const idToken = liff.getIDToken();
    return fetch("/liff/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id_token: idToken })
    });
  })
  .then((res) => {
    if (!res) return; // ← liff.login()のreturnの場合はスキップ
    if (!res.ok) throw new Error("セッションの作成に失敗しました");
    return fetch("/liff/history/data");
  })
  .then((res) => {
    if (!res) return; // ← 同様にスキップ
    if (!res.ok) throw new Error(`サーバーエラー: ${res.status}`);
    return res.json();
  })
  .then((data) => {
    if (!data) return; // ← 同様にスキップ
    renderSummary(data.summary);
    buildHeatmap(data.daily_stats);
    buildMasteryChart(data.mastery_history);
  })
  .catch((err) => {
    console.error("LIFFエラー:", err);
    document.querySelector(".history-container").innerHTML = `<p style="color:red; padding:20px;">エラー: ${err.message}</p>`;
  });
</script>