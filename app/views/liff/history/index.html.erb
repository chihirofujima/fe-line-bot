<style>
/* ===========================
   ベース
=========================== */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
  color: #333;
}

.history-container {
  max-width: 480px;
  margin: 0 auto;
  padding: 16px;
}

.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 16px;
}

.card {
  background: #fff;
  border-radius: 12px;
  padding: 14px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.card-icon {
  width: 28px;
  height: 28px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 14px;
  margin-bottom: 0px;
}

.card-label {
  font-size: 11px;
  color: #888;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 8px;
}

.icon-green  { background-color: #e8f5e9; }
.icon-blue   { background-color: #e3f2fd; }
.icon-orange { background-color: #fff3e0; }

.card-label {
  font-size: 11px;
  color: #888;
  margin-bottom: 4px;
}

.help {
  display: inline-block;
  width: 14px;
  height: 14px;
  background: #ddd;
  border-radius: 50%;
  font-size: 10px;
  text-align: center;
  line-height: 14px;
  color: #666;
  cursor: pointer;
}

.card-value {
  font-size: 28px;
  font-weight: 700;
  color: #222;
  line-height: 1.2;
}

.card-unit {
  font-size: 14px;
  font-weight: 400;
  color: #555;
  margin-left: 2px;
}

.card-desc {
  font-size: 10px;
  color: #aaa;
  margin-top: 4px;
}

.progress-bar {
  height: 6px;
  background: #e0e0e0;
  border-radius: 3px;
  margin-top: 8px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #4CAF50;
  border-radius: 3px;
  transition: width 0.6s ease;
}

.progress-text {
  font-size: 11px;
  color: #888;
  margin-top: 4px;
}

.section {
  background: #fff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 14px;
  font-weight: 600;
  color: #333;
}

.study-days-value {
  font-size: 18px;
  font-weight: 700;
  color: #4CAF50;
}

.heatmap-scroll {
  overflow-x: auto;
  padding-bottom: 4px;
}

.heatmap-month-row {
  display: flex;
  margin-left: 24px;
  margin-bottom: 2px;
}

.heatmap-grid {
  display: flex;
}

.heatmap-day-col {
  display: flex;
  flex-direction: column;
  margin-right: 4px;
}

.heatmap-day-label {
  width: 20px;
  height: 14px;
  font-size: 10px;
  color: #888;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  padding-right: 2px;
  margin-bottom: 2px;
}

.heatmap-col {
  display: flex;
  flex-direction: column;
  margin-right: 2px;
}

.heatmap-month-label {
  height: 14px;
  font-size: 10px;
  color: #888;
  white-space: nowrap;
  margin-bottom: 2px;
}

.heatmap-cell {
  width: 14px;
  height: 14px;
  border-radius: 3px;
  margin-bottom: 2px;
}

.level-0 { background-color: #eee; }
.level-1 { background-color: #c8e6c9; }
.level-2 { background-color: #81c784; }
.level-3 { background-color: #4CAF50; }
.level-4 { background-color: #1b5e20; }

.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 4px;
  margin-top: 10px;
  flex-wrap: wrap;
}

.legend-label {
  font-size: 10px;
  color: #888;
  margin-right: 4px;
}

.legend-cell {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 2px;
}

.legend-text {
  font-size: 10px;
  color: #888;
  margin-right: 6px;
}

.chart-wrapper {
  position: relative;
  height: 220px;
}

.tooltip-box {
  display: none;
  position: fixed;
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  font-size: 11px;
  padding: 6px 10px;
  border-radius: 6px;
  max-width: 160px;
  z-index: 999;
  pointer-events: none;
}
</style>

<div class="history-container">

  <!-- サマリーカード -->
  <div class="summary-grid">
  <div class="card">
    <div class="card-header">
      <div class="card-icon icon-green">📖</div>
      <div class="card-label">総回答数 <span class="help" data-tooltip="これまでに解いた問題の総数">?</span></div>
    </div>
    <div class="card-value"><span id="total-answers">--</span><span class="card-unit">問</span></div>
  </div>
  <div class="card">
    <div class="card-header">
      <div class="card-icon icon-blue">🎯</div>
      <div class="card-label">正答率 <span class="help" data-tooltip="これまで解いた全回答のうち正解した割合">?</span></div>
    </div>
    <div class="card-value"><span id="accuracy-rate">--</span><span class="card-unit">%</span></div>
  </div>
  <div class="card">
    <div class="card-header">
      <div class="card-icon icon-green">🌱</div>
      <div class="card-label">定着度 <span class="help" data-tooltip="一度解いた問題のうち定着した割合">?</span></div>
    </div>
    <div class="card-value"><span id="mastery-rate">--</span><span class="card-unit">%</span></div>
    <div class="progress-bar">
      <div class="progress-fill" id="mastery-progress" style="width: 0%"></div>
    </div>
    <div class="progress-text"><span id="mastery-count">--</span> / <span id="total-tried">--</span>問</div>
  </div>
  <div class="card">
    <div class="card-header">
      <div class="card-icon icon-orange">📅</div>
      <div class="card-label">今日の回答数</div>
    </div>
    <div class="card-value"><span id="today-answers">--</span><span class="card-unit">問</span></div>
  </div>
</div>

<!-- ツールチップ -->
<div class="tooltip-box" id="tooltip"></div>

  <!-- 草グリッド -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">🌱 総学習日数（学習した日）</span>
      <span class="study-days-value" id="study-days">--日</span>
    </div>
    <div class="heatmap-scroll">
      <div id="heatmap-container"></div>
    </div>
    <div class="heatmap-legend">
      <span class="legend-label">学習した日数</span>
      <span class="legend-cell level-0"></span><span class="legend-text">0日</span>
      <span class="legend-cell level-1"></span><span class="legend-text">1日</span>
      <span class="legend-cell level-2"></span><span class="legend-text">2〜3日</span>
      <span class="legend-cell level-3"></span><span class="legend-text">4〜6日</span>
      <span class="legend-cell level-4"></span><span class="legend-text">7以上</span>
    </div>
  </div>

  <!-- 定着度推移グラフ -->
  <div class="section">
    <div class="section-header">
      <span class="section-title">🌱 定着度の推移</span>
    </div>
    <div class="chart-wrapper">
      <canvas id="mastery-chart"></canvas>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
const LIFF_ID_HISTORY = "<%= ENV['LIFF_ID_HISTORY'] %>";

liff.init({ liffId: LIFF_ID_HISTORY })
  .then(() => {
    if (!liff.isLoggedIn()) {
      liff.login();
      return;
    }

    // IDトークンを取得してRailsに送りセッション保存
    const idToken = liff.getIDToken();
    return fetch("/liff/session", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id_token: idToken })
    });
  })
  .then((res) => {
    if (!res) return; // ← liff.login()のreturnの場合はスキップ
    if (!res.ok) throw new Error("セッションの作成に失敗しました");
    return fetch("/liff/history/data");
  })
  .then((res) => {
    if (!res) return; // ← 同様にスキップ
    if (!res.ok) throw new Error(`サーバーエラー: ${res.status}`);
    return res.json();
  })
  .then((data) => {
    if (!data) return; // ← 同様にスキップ
    renderSummary(data.summary);
    buildHeatmap(data.daily_stats);
    buildMasteryChart(data.mastery_history);
  })
  .catch((err) => {
    console.error("LIFFエラー:", err);
    document.querySelector(".history-container").innerHTML = `<p style="color:red; padding:20px;">エラー: ${err.message}</p>`;
  });

// 回答数 → ヒートマップのレベル変換
function countToLevel(count) {
  if (!count || count === 0) return 0;
  if (count === 1) return 1;
  if (count <= 3) return 2;
  if (count <= 6) return 3;
  return 4;
}

// 草グリッドを生成
function buildHeatmap(dailyStats) {
  const container = document.getElementById("heatmap-container");
  const DAY_LABELS = ["月", "火", "水", "木", "金", "<span class='sat'>土</span>", "<span class='sun'>日</span>"];

  // 今日から26週前の月曜日を起点にする
  const today = new Date();
  const dayOfWeek = (today.getDay() + 6) % 7; // 月=0, 日=6
  const startDate = new Date(today);
  startDate.setDate(today.getDate() - dayOfWeek - 26 * 7);

  // 週ごとに列を生成
  const weeks = [];
  let current = new Date(startDate);
  while (current <= today) {
    const week = [];
    for (let d = 0; d < 7; d++) {
      const dateStr = current.toISOString().slice(0, 10);
      const count = dailyStats[dateStr] || 0;
      week.push({ dateStr, count, isFuture: current > today });
      current.setDate(current.getDate() + 1);
    }
    weeks.push(week);
  }

  // 月ラベル行を生成
  const monthRow = document.createElement("div");
  monthRow.className = "heatmap-month-row";
  monthRow.innerHTML = `<div class="heatmap-day-col"><div class="heatmap-month-label"></div></div>`;

  let lastMonth = -1;
  weeks.forEach(week => {
    const col = document.createElement("div");
    col.className = "heatmap-col";
    const firstDay = new Date(week[0].dateStr);
    const month = firstDay.getMonth() + 1;
    const label = document.createElement("div");
    label.className = "heatmap-month-label";
    label.textContent = month !== lastMonth ? `${month}月` : "";
    if (month !== lastMonth) lastMonth = month;
    col.appendChild(label);
    monthRow.appendChild(col);
  });

  // グリッド本体
  const grid = document.createElement("div");
  grid.className = "heatmap-grid";

  // 曜日ラベル列
  const dayCol = document.createElement("div");
  dayCol.className = "heatmap-day-col";
  DAY_LABELS.forEach(label => {
    const cell = document.createElement("div");
    cell.className = "heatmap-day-label";
    cell.innerHTML = label;
    dayCol.appendChild(cell);
  });
  grid.appendChild(dayCol);

  // 週ごとの列
  weeks.forEach(week => {
    const col = document.createElement("div");
    col.className = "heatmap-col";
    week.forEach(({ dateStr, count, isFuture }) => {
      const cell = document.createElement("div");
      cell.className = `heatmap-cell level-${isFuture ? 0 : countToLevel(count)}`;
      cell.title = `${dateStr}: ${count}問`;
      col.appendChild(cell);
    });
    grid.appendChild(col);
  });

  container.appendChild(monthRow);
  container.appendChild(grid);
}

// 定着度グラフを生成
function buildMasteryChart(masteryHistory) {
  const ctx = document.getElementById("mastery-chart").getContext("2d");
  new Chart(ctx, {
    type: "line",
    data: {
      labels: masteryHistory.map(d => d.date),
      datasets: [{
        data: masteryHistory.map(d => d.mastery_rate),
        borderColor: "#4CAF50",
        backgroundColor: "rgba(76, 175, 80, 0.1)",
        fill: true,
        tension: 0.3,
        pointBackgroundColor: "#fff",
        pointBorderColor: "#4CAF50",
        pointRadius: 4,
      }]
    },
    options: {
      responsive: true,
      plugins: { legend: { display: false } },
      scales: {
        y: {
          min: 0, max: 100,
          ticks: { callback: v => v + "%" }
        }
      }
    }
  });
}

// サマリーカードに値をセット
function renderSummary(summary) {
  document.getElementById("total-answers").textContent  = summary.total_answers.toLocaleString();
  document.getElementById("accuracy-rate").textContent  = summary.accuracy_rate;
  document.getElementById("mastery-rate").textContent   = summary.mastery_rate;
  document.getElementById("today-answers").textContent  = summary.today_answers;
  document.getElementById("study-days").textContent     = summary.total_study_days + "日";
  document.getElementById("mastery-count").textContent  = summary.mastered_count;
  document.getElementById("total-tried").textContent    = summary.total_questions_tried;
  document.getElementById("mastery-progress").style.width = summary.mastery_rate + "%";
}

// ツールチップ
const tooltip = document.getElementById("tooltip");
document.querySelectorAll(".help[data-tooltip]").forEach(el => {
  el.addEventListener("click", (e) => {
    const text = el.dataset.tooltip;
    tooltip.textContent = text;
    tooltip.style.display = "block";
    tooltip.style.left = (e.clientX - 80) + "px";
    tooltip.style.top  = (e.clientY + 12) + "px";
    setTimeout(() => { tooltip.style.display = "none"; }, 2500);
  });
});
</script>